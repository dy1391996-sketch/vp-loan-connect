# Core
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vploanconnect?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production: https://www.vploanconnect.in  (apex host is permanently redirected to www)
NEXTAUTH_SECRET=""
REPORT_SIGNING_SECRET=""

# Payments
# Switch gateway with PAYMENT_PROVIDER without changing business logic.
# Supported: mock | razorpay | cashfree | phonepe | payu
# Production must NOT use mock. Only the selected provider's credentials are required.
PAYMENT_PROVIDER="mock"

# Razorpay (collect from Razorpay Dashboard → API Keys + Webhooks)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cashfree Payments (collect from Cashfree Merchant Dashboard → Developers)
# Prefer CASHFREE_APP_ID / CASHFREE_SECRET_KEY. CASHFREE_CLIENT_ID / CASHFREE_CLIENT_SECRET are accepted as aliases.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
# CASHFREE_CLIENT_ID=""
# CASHFREE_CLIENT_SECRET=""
CASHFREE_WEBHOOK_SECRET=""
CASHFREE_ENV="sandbox"
CASHFREE_API_VERSION="2025-01-01"
# Browser checkout mode is derived server-side from CASHFREE_ENV (never put secrets in NEXT_PUBLIC_*).
# NEXT_PUBLIC_CASHFREE_MODE is optional/legacy; prefer server checkout.env from create-order.

# PhonePe PG (collect from PhonePe Business Dashboard → Developer settings)
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX="1"
PHONEPE_ENV="sandbox"

# PayU (collect from PayU Merchant Dashboard → Key & Salt)
PAYU_KEY=""
PAYU_SALT=""
PAYU_ENV="test"

# WhatsApp Business Platform (WHATSAPP_PROVIDER=mock for local development)
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_URL="https://graph.facebook.com/v22.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# OTP / MSG91 (email widget only — SMS SendOTP removed)
# Assessment verify step uses MSG91 Email Widget:
#   NEXT_PUBLIC_MSG91_WIDGET_ID + NEXT_PUBLIC_MSG91_WIDGET_TOKEN (browser)
#   OTP_API_KEY (server) verifies widget access tokens at /api/otp/verify
# CRITICAL branding in MSG91 dashboard:
#   Email → Domains / From Name = "VP Loan Connect"
#   OTP Widget email template sender name = "VP Loan Connect"
#   Never use personal name or personal Gmail as From.
OTP_PROVIDER="custom"
OTP_API_KEY="YOUR_MSG91_AUTH_KEY"
# Legacy SMS SendOTP URL — unused after email-only cutover (kept optional for local fixtures)
OTP_API_URL=""
MOCK_OTP_CODE="123456"
# From OTP Widget → Integrate code (Token Auth often looks long; Widget ID is shorter)
NEXT_PUBLIC_MSG91_WIDGET_ID=""
NEXT_PUBLIC_MSG91_WIDGET_TOKEN=""

# Privacy controls (off by default; enable only after a documented lawful-basis review)
STORE_CONSENT_IP="false"

# Initial administrator (used only by the seed command)
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# Business identity (legal/backend only — do not expose personal names/emails on the public site)
# Public brand is always "VP Loan Connect". SUPPORT_EMAIL should be @vploanconnect.in
BUSINESS_NAME="VP Loan Connect"
BUSINESS_GSTIN=""
BUSINESS_ADDRESS=""
SUPPORT_EMAIL="support@vploanconnect.in"
SUPPORT_WHATSAPP=""
GRIEVANCE_NAME=""
GRIEVANCE_EMAIL=""

# Optional privacy-conscious analytics destination/id
ANALYTICS_ID=""
# Consent-gated browser analytics (optional — leave empty to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Public Instagram profile or Direct link (https://www.instagram.com/... or https://ig.me/m/...)
NEXT_PUBLIC_INSTAGRAM_URL=""

# Meta Pixel + Conversions API (optional — missing values must not break production)
# Browser Pixel ID (public). Load only after marketing consent.
NEXT_PUBLIC_META_PIXEL_ID=""
# Server CAPI token from Meta Events Manager → Settings → Conversions API
META_CAPI_ACCESS_TOKEN=""
# Optional override; defaults to NEXT_PUBLIC_META_PIXEL_ID when unset
META_CAPI_PIXEL_ID=""
# Optional Meta Test Events code for sandbox verification
META_TEST_EVENT_CODE=""
META_GRAPH_API_VERSION="v22.0"
