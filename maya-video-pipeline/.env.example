# Copy to .env and fill only keys you already own.
# Never commit .env. This pipeline never purchases credits.

# Google Gemini / Veo (preferred when authenticated)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Runway
# RUNWAYML_API_SECRET=

# fal.ai — do not use unless balance is confirmed usable.
# Previous observed status: 403 User is locked / Exhausted balance
# FAL_KEY=

# Optional others (used only if already configured and suitable)
# REPLICATE_API_TOKEN=
# LUMAAI_API_KEY=
