generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum StaffRole {
  OWNER
  BOOKING_MANAGER
  SOCIAL_MEDIA_MANAGER
  HOUSEKEEPING_MANAGER
  READ_ONLY
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM_DM
  INSTAGRAM_COMMENT
  WEBSITE
  DIRECT
  PHONE
  OTHER
}

enum LanguagePref {
  EN
  HI
  HINGLISH
  UNKNOWN
}

enum LeadStage {
  NEW_ENQUIRY
  QUALIFICATION_PENDING
  AVAILABILITY_SHARED
  PRICE_SHARED
  PHOTOS_SHARED
  PAYMENT_LINK_SENT
  TOKEN_PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  REVIEW_REQUESTED
  REPEAT_LEAD
  LOST
  SPAM
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum StudioCategory {
  STANDARD
  PREMIUM
  BALCONY
  JACUZZI
  PREMIUM_VIEW
}

enum StudioCondition {
  EXCELLENT
  GOOD
  FAIR
  NEEDS_ATTENTION
}

enum CleaningStatus {
  CLEAN
  DIRTY
  IN_PROGRESS
  INSPECTING
  READY
}

enum AvailabilityStatus {
  AVAILABLE
  TENTATIVELY_BLOCKED
  TOKEN_PENDING
  CONFIRMED_BOOKING
  OCCUPIED
  CHECKOUT_PENDING
  CLEANING_IN_PROGRESS
  READY
  MAINTENANCE_BLOCKED
}

enum PricingRuleType {
  WEEKDAY_SLAB
  WEEKEND_SLAB
  HOURLY
  SPECIAL_DATE
  HOLIDAY
  OCCUPANCY
  LAST_MINUTE
  RETURNING_CUSTOMER
  LONG_STAY
  COUPON
  MANUAL_OVERRIDE
  PREMIUM_SURCHARGE
}

enum HoldStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

enum BookingStatus {
  DRAFT
  HOLD
  TOKEN_PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentKind {
  TOKEN
  BALANCE
  FULL
  EXTENSION
  EXTRA
  REFUND
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

enum FollowUpStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
  SKIPPED
}

enum FollowUpType {
  NO_REPLY_AFTER_PRICE
  UNPAID_TOKEN
  TODAY_AVAILABILITY
  FUTURE_DATE
  LOST_PRICE
  PAST_CUSTOMER
  PRE_ARRIVAL
  CHECKOUT
  REVIEW
  CUSTOM
}

enum ConversationStatus {
  OPEN
  AI_ACTIVE
  HUMAN_HANDOVER
  RESOLVED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ContentMode {
  DRAFT
  SCHEDULED_APPROVAL
  TRUSTED_AUTO_PUBLISH
}

enum ContentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
  FAILED
}

enum ContentCategory {
  STUDIO_SHOWCASE
  ROOM_TOUR
  BALCONY_VIEW
  JACUZZI_STUDIO
  AFFORDABLE_SHORT_STAY
  WORK_FROM_STUDIO
  WEEKEND_STAY
  COUPLE_STAY
  BIRTHDAY_DECORATION
  LONG_STAY
  CUSTOMER_REVIEW
  LOCATION_ADVANTAGE
  HYGIENE_CLEANING
  BOOKING_PROCESS
  FAQ
  FESTIVAL
  OFFER
  AVAILABILITY
  BEHIND_SCENES
  SELF_CHECKIN
}

enum CommentCategory {
  BOOKING_ENQUIRY
  PRICE_ENQUIRY
  AVAILABILITY_ENQUIRY
  LOCATION_ENQUIRY
  POSITIVE_FEEDBACK
  COMPLAINT
  SPAM
  ABUSIVE
  COLLABORATION
  COMPETITOR
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum CleaningType {
  DAILY
  CHECKOUT
  DEEP
}

enum CleaningTaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  RESOLVED
}

enum ReviewRequestStatus {
  PENDING
  SENT
  COMPLETED
  SKIPPED
}

enum IntegrationProvider {
  WHATSAPP
  INSTAGRAM
  RAZORPAY
  OPENAI
  CLOUDINARY
  VERCEL_BLOB
  REDIS
  GOOGLE_REVIEW
}

enum WebhookProvider {
  META
  RAZORPAY
  OTHER
}

enum WebhookProcessStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
  IGNORED
}

// ─── Auth & staff ────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         StaffRole @default(READ_ONLY)
  phone        String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?

  sessions          Session[]
  assignedLeads     Lead[]              @relation("LeadAssignee")
  assignedTickets   SupportTicket[]     @relation("TicketAssignee")
  assignedCleaning  CleaningTask[]      @relation("CleaningAssignee")
  auditLogs         AuditLog[]
  approvedContent   ContentDraft[]      @relation("ContentApprover")
  internalNotes     ConversationNote[]
  createdBookings   Booking[]           @relation("BookingCreator")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipHash    String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Customers & CRM ─────────────────────────────────────────────────────────

model Customer {
  id                   String       @id @default(cuid())
  name                 String?
  phone                String?      @unique
  email                String?
  preferredLanguage    LanguagePref @default(UNKNOWN)
  returningCustomer    Boolean      @default(false)
  optedOut             Boolean      @default(false)
  optedOutAt           DateTime?
  preferredStudioId    String?
  balconyPreference    Boolean?
  jacuzziPreference    Boolean?
  notes                String?
  memorySummary        String?
  governmentIdVerified Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  createdById          String?

  channels       CustomerChannel[]
  conversations  Conversation[]
  leads          Lead[]
  bookings       Booking[]
  payments       Payment[]
  followUps      FollowUp[]
  tickets        SupportTicket[]
  reviews        CustomerReview[]
  reviewRequests ReviewRequest[]
  preferredStudio Studio? @relation("PreferredStudio", fields: [preferredStudioId], references: [id])

  @@index([phone])
  @@index([optedOut])
}

model CustomerChannel {
  id                String      @id @default(cuid())
  customerId        String
  channel           ChannelType
  externalId        String
  displayName       String?
  metadata          Json?
  lastMessageAt     DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([customerId])
}

model Lead {
  id                  String          @id @default(cuid())
  customerId          String
  source              ChannelType     @default(WHATSAPP)
  campaignId          String?
  stage               LeadStage       @default(NEW_ENQUIRY)
  temperature         LeadTemperature @default(WARM)
  bookingProbability  Int             @default(20)
  name                String?
  phone               String?
  instagramUsername   String?
  requiredDate        DateTime?
  checkInTime         String?
  durationHours       Int?
  guestCount          Int?
  budgetInr           Int?
  studioPreference    String?
  balconyPref         Boolean?
  jacuzziPref         Boolean?
  premiumViewPref     Boolean?
  assignedStaffId     String?
  followUpAt          DateTime?
  conversationSummary String?
  aiDetectedIntent    String?
  lostReason          String?
  bookingValueInr     Int?
  returningCustomer   Boolean         @default(false)
  firstContactAt      DateTime        @default(now())
  lastContactAt       DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  createdById         String?

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaign      Campaign?      @relation(fields: [campaignId], references: [id])
  assignedStaff User?          @relation("LeadAssignee", fields: [assignedStaffId], references: [id])
  activities    LeadActivity[]
  bookings      Booking[]
  followUps     FollowUp[]

  @@index([stage])
  @@index([temperature])
  @@index([customerId])
  @@index([source])
  @@index([followUpAt])
  @@index([requiredDate])
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String
  type        String
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())
  createdById String?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// ─── Conversations / inbox ───────────────────────────────────────────────────

model Conversation {
  id              String             @id @default(cuid())
  customerId      String
  channel         ChannelType
  externalThreadId String?
  status          ConversationStatus @default(AI_ACTIVE)
  aiPaused        Boolean            @default(false)
  assignedStaffId String?
  summary         String?
  pendingAction   String?
  tags            String[]           @default([])
  unreadCount     Int                @default(0)
  urgent          Boolean            @default(false)
  lastMessageAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  customer  Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages  Message[]
  notes     ConversationNote[]
  tickets   SupportTicket[]

  @@unique([channel, externalThreadId])
  @@index([customerId])
  @@index([status])
  @@index([urgent])
  @@index([lastMessageAt])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  direction         MessageDirection
  status            MessageStatus    @default(RECEIVED)
  body              String?
  mediaUrl          String?
  mediaType         String?
  externalMessageId String?          @unique
  intent            String?
  language          LanguagePref?
  aiGenerated       Boolean          @default(false)
  aiConfidence      Float?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdById       String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ConversationNote {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([conversationId])
}

// ─── Studios & media ─────────────────────────────────────────────────────────

model Studio {
  id                String             @id @default(cuid())
  number            String             @unique
  property          String             @default("Gaur City Center")
  building          String?
  floor             Int?
  title             String
  category          StudioCategory     @default(STANDARD)
  isPremium         Boolean            @default(false)
  hasBalcony        Boolean            @default(false)
  hasJacuzzi        Boolean            @default(false)
  viewType          String?
  maxGuests         Int                @default(2)
  condition         StudioCondition    @default(GOOD)
  cleaningStatus    CleaningStatus     @default(READY)
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  wifiAvailable     Boolean            @default(true)
  amenities         String[]           @default([])
  weekdayPriceInr   Int?
  weekendPriceInr   Int?
  hourlyPriceInr    Int?
  securityDepositInr Int?
  checkInTime       String             @default("12:00")
  checkOutTime      String             @default("11:00")
  publicDescription String?
  internalNotes     String?
  active            Boolean            @default(true)
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdById       String?

  media              StudioMedia[]
  availabilityBlocks AvailabilityBlock[]
  holds              TemporaryHold[]
  bookings           Booking[]
  cleaningTasks      CleaningTask[]
  maintenanceTasks   MaintenanceTask[]
  preferredBy        Customer[]          @relation("PreferredStudio")

  @@index([availabilityStatus])
  @@index([active])
  @@index([category])
}

model StudioMedia {
  id          String   @id @default(cuid())
  studioId    String
  url         String
  publicId    String?
  mediaType   String   @default("image")
  isCover     Boolean  @default(false)
  tags        String[] @default([])
  approved    Boolean  @default(false)
  needsEdit   Boolean  @default(false)
  isCurrent   Boolean  @default(true)
  orientation String?
  reelReady   Boolean  @default(false)
  storyReady  Boolean  @default(false)
  dayNight    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([approved])
}

// ─── Pricing ─────────────────────────────────────────────────────────────────

model PricingRule {
  id            String          @id @default(cuid())
  name          String
  type          PricingRuleType
  active        Boolean         @default(true)
  priority      Int             @default(100)
  // Duration slab in hours (inclusive range)
  minHours      Int?
  maxHours      Int?
  // Day applicability: WEEKDAY | WEEKEND | ANY | specific ISO dates via specialDate
  dayType       String          @default("ANY")
  specialDate   DateTime?
  specialDateEnd DateTime?
  amountInr     Int
  isPercent     Boolean         @default(false)
  percentValue  Float?
  couponCode    String?         @unique
  studioId      String?
  category      StudioCategory?
  minOccupancy  Float?
  maxOccupancy  Float?
  returningOnly Boolean         @default(false)
  requiresOwnerApproval Boolean @default(false)
  approved      Boolean         @default(true)
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdById   String?

  @@index([type, active])
  @@index([couponCode])
}

// ─── Availability & holds ────────────────────────────────────────────────────

model AvailabilityBlock {
  id          String   @id @default(cuid())
  studioId    String
  startsAt    DateTime
  endsAt      DateTime
  reason      String
  bookingId   String?
  holdId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  studio  Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  booking Booking?        @relation(fields: [bookingId], references: [id])
  hold    TemporaryHold?  @relation(fields: [holdId], references: [id])

  @@index([studioId, startsAt, endsAt])
  @@index([bookingId])
}

model TemporaryHold {
  id          String     @id @default(cuid())
  studioId    String
  customerId  String?
  leadId      String?
  startsAt    DateTime
  endsAt      DateTime
  expiresAt   DateTime
  status      HoldStatus @default(ACTIVE)
  idempotencyKey String? @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?

  studio Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  blocks AvailabilityBlock[]
  booking Booking?

  @@index([studioId, status, expiresAt])
  @@index([expiresAt])
}

// ─── Bookings & payments ─────────────────────────────────────────────────────

model Booking {
  id              String        @id @default(cuid())
  reference       String        @unique
  customerId      String
  leadId          String?
  studioId        String
  holdId          String?       @unique
  status          BookingStatus @default(DRAFT)
  checkInAt       DateTime
  checkOutAt      DateTime
  durationHours   Int
  guestCount      Int           @default(2)
  baseAmountInr   Int
  discountInr     Int           @default(0)
  tokenAmountInr  Int
  totalAmountInr  Int
  couponCode      String?
  priceOverrideInr Int?
  priceOverrideReason String?
  locationSent    Boolean       @default(false)
  idRequested     Boolean       @default(false)
  accessShared    Boolean       @default(false)
  houseRulesSent  Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?

  customer   Customer       @relation(fields: [customerId], references: [id])
  lead       Lead?          @relation(fields: [leadId], references: [id])
  studio     Studio         @relation(fields: [studioId], references: [id])
  hold       TemporaryHold? @relation(fields: [holdId], references: [id])
  creator    User?          @relation("BookingCreator", fields: [createdById], references: [id])
  guests     BookingGuest[]
  payments   Payment[]
  refunds    Refund[]
  blocks     AvailabilityBlock[]
  cleaningTasks CleaningTask[]
  reviewRequests ReviewRequest[]
  tickets    SupportTicket[]

  @@index([status])
  @@index([studioId, checkInAt, checkOutAt])
  @@index([customerId])
  @@index([checkInAt])
}

model BookingGuest {
  id        String   @id @default(cuid())
  bookingId String
  name      String
  phone     String?
  idType    String?
  idNumberMasked String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String?
  customerId        String
  kind              PaymentKind   @default(TOKEN)
  status            PaymentStatus @default(CREATED)
  amountInr         Int
  currency          String        @default("INR")
  provider          String        @default("razorpay")
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  paymentLinkUrl    String?
  paymentLinkId     String?
  idempotencyKey    String?       @unique
  paidAt            DateTime?
  failureReason     String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdById       String?

  booking  Booking? @relation(fields: [bookingId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  refunds  Refund[]

  @@index([status])
  @@index([bookingId])
  @@index([customerId])
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  bookingId        String?
  amountInr        Int
  status           RefundStatus @default(REQUESTED)
  reason           String?
  providerRefundId String?      @unique
  idempotencyKey   String?      @unique
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdById      String?

  payment Payment  @relation(fields: [paymentId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([status])
}

// ─── Follow-ups ──────────────────────────────────────────────────────────────

model FollowUp {
  id          String         @id @default(cuid())
  customerId  String
  leadId      String?
  type        FollowUpType
  status      FollowUpStatus @default(SCHEDULED)
  channel     ChannelType    @default(WHATSAPP)
  scheduledAt DateTime
  sentAt      DateTime?
  templateKey String?
  payload     Json?
  attempt     Int            @default(0)
  maxAttempts Int            @default(3)
  cancelReason String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id])

  @@index([status, scheduledAt])
  @@index([customerId])
}

// ─── Marketing / content ─────────────────────────────────────────────────────

model Campaign {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  leads   Lead[]
  drafts  ContentDraft[]
  posts   SocialPost[]
}

model ContentDraft {
  id                 String          @id @default(cuid())
  campaignId         String?
  category           ContentCategory
  mode               ContentMode     @default(DRAFT)
  status             ContentStatus   @default(DRAFT)
  objective          String?
  targetAudience     String?
  hook               String?
  script             String?
  caption            String?
  cta                String?
  hashtags           String[]        @default([])
  recommendedTime    DateTime?
  suggestedShots     String?
  offerPromoted      String?
  trackingCode       String?
  requiresApproval   Boolean         @default(true)
  approvedById       String?
  approvedAt         DateTime?
  scheduledAt        DateTime?
  sensitive          Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  createdById        String?

  campaign   Campaign?   @relation(fields: [campaignId], references: [id])
  approvedBy User?       @relation("ContentApprover", fields: [approvedById], references: [id])
  posts      SocialPost[]

  @@index([status])
  @@index([scheduledAt])
  @@index([category])
}

model SocialPost {
  id              String        @id @default(cuid())
  draftId         String?
  campaignId      String?
  platform        String        @default("instagram")
  externalPostId  String?
  permalink       String?
  status          ContentStatus @default(SCHEDULED)
  publishedAt     DateTime?
  mediaUrls       String[]      @default([])
  caption         String?
  reach           Int?
  engagement      Int?
  profileVisits   Int?
  dmsGenerated    Int?
  leadsGenerated  Int?
  bookingsGenerated Int?
  revenueAttributedInr Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?

  draft    ContentDraft?   @relation(fields: [draftId], references: [id])
  campaign Campaign?       @relation(fields: [campaignId], references: [id])
  comments SocialComment[]
  analytics SocialAnalytics[]

  @@index([status])
  @@index([publishedAt])
}

model SocialComment {
  id               String          @id @default(cuid())
  postId           String?
  externalCommentId String?        @unique
  authorUsername   String?
  body             String
  category         CommentCategory @default(OTHER)
  publicReply      String?
  replyApproved    Boolean         @default(false)
  repliedAt        DateTime?
  requiresHuman    Boolean         @default(false)
  leadId           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  post SocialPost? @relation(fields: [postId], references: [id])

  @@index([category])
  @@index([requiresHuman])
}

model SocialAnalytics {
  id        String   @id @default(cuid())
  postId    String
  metric    String
  value     Float
  capturedAt DateTime @default(now())
  createdAt DateTime @default(now())

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, metric])
}

// ─── Support, cleaning, maintenance, reviews ─────────────────────────────────

model SupportTicket {
  id             String         @id @default(cuid())
  customerId     String?
  conversationId String?
  bookingId      String?
  subject        String
  description    String
  priority       TicketPriority @default(NORMAL)
  status         TicketStatus   @default(OPEN)
  assignedStaffId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?

  customer     Customer?     @relation(fields: [customerId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  booking      Booking?      @relation(fields: [bookingId], references: [id])
  assignee     User?         @relation("TicketAssignee", fields: [assignedStaffId], references: [id])

  @@index([status, priority])
}

model CleaningTask {
  id               String             @id @default(cuid())
  studioId         String
  bookingId        String?
  type             CleaningType       @default(CHECKOUT)
  status           CleaningTaskStatus @default(PENDING)
  assignedCleanerId String?
  checkoutTime     DateTime?
  startTime        DateTime?
  completionTime   DateTime?
  linenChanged     Boolean            @default(false)
  towelsChanged    Boolean            @default(false)
  bathroomCleaned  Boolean            @default(false)
  amenitiesRefilled Boolean           @default(false)
  damageFound      Boolean            @default(false)
  damageNotes      String?
  supervisorApproved Boolean          @default(false)
  supervisorId     String?
  studioReady      Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdById      String?

  studio   Studio          @relation(fields: [studioId], references: [id])
  booking  Booking?        @relation(fields: [bookingId], references: [id])
  assignee User?           @relation("CleaningAssignee", fields: [assignedCleanerId], references: [id])
  proofs   CleaningProof[]

  @@index([status])
  @@index([studioId])
}

model CleaningProof {
  id        String   @id @default(cuid())
  taskId    String
  kind      String
  url       String
  createdAt DateTime @default(now())
  createdById String?

  task CleaningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model MaintenanceTask {
  id          String            @id @default(cuid())
  studioId    String
  title       String
  description String?
  status      MaintenanceStatus @default(OPEN)
  blocksStudio Boolean          @default(true)
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdById String?

  studio Studio @relation(fields: [studioId], references: [id])

  @@index([status])
  @@index([studioId])
}

model ReviewRequest {
  id          String              @id @default(cuid())
  customerId  String
  bookingId   String
  status      ReviewRequestStatus @default(PENDING)
  channel     ChannelType         @default(WHATSAPP)
  sentAt      DateTime?
  skipReason  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  booking  Booking  @relation(fields: [bookingId], references: [id])

  @@index([status])
}

model CustomerReview {
  id         String   @id @default(cuid())
  customerId String
  source     String
  rating     Int?
  body       String?
  publicUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

// ─── Notifications, AI, reports ──────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

model AIAction {
  id          String   @id @default(cuid())
  toolName    String
  input       Json
  output      Json?
  success     Boolean  @default(true)
  error       String?
  conversationId String?
  leadId      String?
  bookingId   String?
  createdAt   DateTime @default(now())
  createdById String?

  @@index([toolName, createdAt])
}

model AIAnalysis {
  id        String   @id @default(cuid())
  kind      String
  periodStart DateTime
  periodEnd DateTime
  summary   String
  actions   Json?
  metrics   Json?
  createdAt DateTime @default(now())

  @@index([kind, periodStart])
}

model DailyReport {
  id          String   @id @default(cuid())
  reportDate  DateTime @unique @db.Date
  payload     Json
  summary     String
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeeklyReport {
  id          String   @id @default(cuid())
  weekStart   DateTime @unique @db.Date
  payload     Json
  summary     String
  actionPlan  String?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Platform ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Integration {
  id           String              @id @default(cuid())
  provider     IntegrationProvider @unique
  enabled      Boolean             @default(false)
  sandboxMode  Boolean             @default(true)
  // Encrypted JSON blob of credentials — never expose to client
  credentialsEnc String?
  metadata     Json?
  lastSyncedAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdById  String?
}

model WebhookEvent {
  id             String               @id @default(cuid())
  provider       WebhookProvider
  eventType      String
  idempotencyKey String               @unique
  payload        Json
  status         WebhookProcessStatus @default(RECEIVED)
  error          String?
  processedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([provider, status])
  @@index([createdAt])
}

model BusinessSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  createdById String?
}

model MessageTemplate {
  id          String      @id @default(cuid())
  key         String      @unique
  channel     ChannelType @default(WHATSAPP)
  language    LanguagePref @default(EN)
  name        String
  body        String
  metaTemplateName String?
  approved    Boolean     @default(false)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String?
}
