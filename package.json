{
  "name": "vp-nest-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "tsx scripts/validate-production-env.ts",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx'",
    "test:watch": "tsx --test --watch 'src/**/*.test.ts' 'src/**/*.test.tsx'",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "verify:readiness": "tsx scripts/verify-readiness.ts",
    "check:env": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.21",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.22",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  },
  "packageManager": "pnpm@11.9.0"
}
