# Personal Video Agent — local/free by default.
# Copy to .env only if you need to override defaults.
# Never commit secrets.

# Bind address. 127.0.0.1 keeps the UI on this machine only.
VIDEO_AGENT_HOST=127.0.0.1
VIDEO_AGENT_PORT=7860

# Local neural worker (localhost only). Do not expose publicly.
VIDEO_AGENT_WORKER_URL=http://127.0.0.1:7861
VIDEO_AGENT_WORKER_HOST=127.0.0.1
VIDEO_AGENT_WORKER_PORT=7861
# VIDEO_AGENT_MODEL_ID=Lightricks/LTX-Video

# Optional paid cloud providers are NOT used by the agent UI.
# They remain isolated in maya-video-pipeline/ and require explicit CLI confirmation.
# GEMINI_API_KEY=
# RUNWAYML_API_SECRET=
# FAL_KEY=
